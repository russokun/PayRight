# URL base de la API v1 de payright-web. Se inlinea en el build: debe llamarse EXPO_PUBLIC_API_URL.
# - Navegador / simulador iOS:  http://localhost:3000/api/v1   (el puerto de `npm run dev` en payright-web)
# - Emulador Android:           http://10.0.2.2:3000/api/v1   (localhost apunta al propio emulador)
# - Teléfono real:              http://<IP de tu computador en la red>:3000/api/v1
# - Producción:                 https://<dominio>/api/v1       (HTTPS: iOS/Android bloquean HTTP en claro en builds de tienda)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
