{
  "expo": {
    "name": "PayRight",
    "slug": "payright",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "payright",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.payright.app"
    },
    "android": {
      "package": "cl.payright.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "PayRight usa la cámara para escanear códigos de barras y fotografiar precios de góndola."
        }
      ],
      "expo-image",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PayRight usa tu ubicación para mostrarte los supermercados y los precios más cercanos a ti."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
